FROM python:3.13-slim

RUN apt-get -y update; apt-get -y install curl

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

ENV TAPIS_BASE_URL=https://tacc.tapis.io
ENV RAG_BASE_URL=https://rag.pods.tacc.tapis.io/chat
ENV FASTMCP_LOG_LEVEL=ERROR

# Set the working directory inside the container
WORKDIR /app
COPY pyproject.toml ./
### comment this for production
# COPY .env .env

RUN uv sync 
ENV PATH="/app/.venv/bin:$PATH"

# Copy the rest of your project's source code into the container
COPY tapis_mcp_server.py tapis_mcp_server.py


# Expose the port your server listens on (adjust if needed, default might be 8000)
EXPOSE 9001

# Command to run the server when the container starts (replace 'your_server_script.py' and 'main_function' with your details)
# CMD ["uv", "run", "tapis_mcp_server.py", "--factory", "tapis_mcp_server.py:main"]
ENTRYPOINT ["python"]
CMD ["tapis_mcp_server.py"]